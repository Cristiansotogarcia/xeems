{
  "expo": {
    "name": "XEEMS",
    "slug": "fieldops-gps",
    "scheme": "xeems",
    "jsEngine": "jsc",
    "icon": "./assets/xeems-icon.png",
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "image": "./assets/xeems-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4f8fb"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xeems.employee",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "XEEMS uses your location on this company-issued phone while your shift is active and under written company notification.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "XEEMS can continue collecting location in the background only while your shift is active on this company-issued phone.",
        "UIBackgroundModes": ["location"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.xeems.employee",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION", "ACCESS_BACKGROUND_LOCATION", "FOREGROUND_SERVICE", "FOREGROUND_SERVICE_LOCATION"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/xeems-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "extra": {
      "eas": {
        "projectId": "51fae249-73a6-414f-8fa8-18a04d03df53"
      }
    }
  }
}
