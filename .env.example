# Root env template for local development
# Fill these values from Supabase > Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=https://downloads.example.com/XEEMS-Setup.exe
NEXT_PUBLIC_ANDROID_DOWNLOAD_URL=https://downloads.example.com/xeems-android
NEXT_PUBLIC_IOS_DOWNLOAD_URL=https://downloads.example.com/xeems-ios
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
MAPBOX_ACCESS_TOKEN=your-mapbox-token
LOCATION_BATCH_SECONDS=60
GEOFENCE_DWELL_SECONDS=120
SHIFT_AUTO_STOP_HOURS=16
